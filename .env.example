# Copy to .env.local. Never commit real keys.

# Cala API key. If unset, the server also looks for a one-line file at ~/.cala_key.
CALA_API_KEY=

# Live calls the server may make for "Find yourself" before it falls back to the cached graph only.
CALA_LIVE_BUDGET=10

# Optional. Only used to reword the intro draft; without it the draft is built from a template.
ANTHROPIC_API_KEY=
INTRO_LLM_BUDGET=40
