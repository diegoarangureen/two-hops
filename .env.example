# Copy to .env.local. Never commit real keys.

# Cala API key. If unset, the server also looks for a one-line file at ~/.cala_key.
CALA_API_KEY=

# Live calls the server may make for "Find yourself" before it falls back to the cached graph only.
CALA_LIVE_BUDGET=10

# Optional. What the Cala plan allows per month: when set, the server also stops at what the call log
# (data/cala_calls.jsonl) shows is left for this key, and the tools report it.
# CALA_MONTHLY_CREDITS=100

# Optional, for tests only: point the live call at a local stand-in for Cala.
# CALA_API_BASE=http://127.0.0.1:3999/v1

# Optional. Only used to reword the intro draft; without it the draft is built from a template.
ANTHROPIC_API_KEY=
INTRO_LLM_BUDGET=40
